<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/alpine_display_green" />
            <stroke android:width="1dp" android:color="@color/alpine_display_green" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/alpine_display_panel_pressed" />
            <stroke android:width="1dp" android:color="@color/alpine_display_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/alpine_display_panel" />
            <stroke android:width="1dp" android:color="@color/alpine_display_border" />
        </shape>
    </item>
</selector>
