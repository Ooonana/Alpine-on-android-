#!/bin/sh

set -u

CONFIG_FILE="/etc/alpine-desktop"
APK_CMD="${APK_CMD:-/sbin/apk}"

print_help() {
    cat <<'EOF'
Usage:
  install-desktop
  install-desktop <xfce|lxqt|lxde|openbox|mate|plasma>
  install-desktop --list
  install-desktop --help

Installs one desktop environment for the Alpine-on-Android integrated X11 display.
Only the selected desktop is installed. Installing another desktop later keeps the
previous desktop packages but changes the default used by start-desktop.
EOF
}

print_choices() {
    cat <<'EOF'
Available desktops:
  1) XFCE      - recommended; light, mature, full desktop
  2) LXQt      - light Qt desktop
  3) LXDE      - very light classic desktop
  4) Openbox   - minimal window manager + panel/file manager
  5) MATE      - traditional full desktop
  6) Plasma    - heaviest; X11 support is experimental on Alpine 3.24
EOF
}

normalize_choice() {
    case "${1:-}" in
        1|xfce|XFCE|Xfce) printf '%s\n' xfce ;;
        2|lxqt|LXQT|LXQt) printf '%s\n' lxqt ;;
        3|lxde|LXDE|Lxde) printf '%s\n' lxde ;;
        4|openbox|Openbox|OPENBOX) printf '%s\n' openbox ;;
        5|mate|MATE|Mate) printf '%s\n' mate ;;
        6|plasma|PLASMA|Plasma|kde|KDE) printf '%s\n' plasma ;;
        *) return 1 ;;
    esac
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    print_help
    exit 0
fi

if [ "${1:-}" = "--list" ]; then
    print_choices
    exit 0
fi

if [ "$(id -u 2>/dev/null || echo 1)" != "0" ]; then
    echo "ERROR: install-desktop must run as root inside Alpine." >&2
    exit 1
fi

if [ ! -x "$APK_CMD" ]; then
    APK_CMD="$(command -v apk 2>/dev/null || true)"
fi
if [ -z "$APK_CMD" ] || [ ! -x "$APK_CMD" ]; then
    echo "ERROR: Alpine apk command was not found." >&2
    exit 1
fi

choice="${1:-}"
if [ -z "$choice" ]; then
    echo "Alpine-on-Android desktop installer"
    echo
    print_choices
    echo
    printf "Choose a desktop [1-6, q to cancel]: "
    IFS= read -r choice || exit 1
    case "$choice" in
        q|Q|quit|QUIT) exit 0 ;;
    esac
fi

desktop="$(normalize_choice "$choice" 2>/dev/null || true)"
if [ -z "$desktop" ]; then
    echo "ERROR: unknown desktop choice: $choice" >&2
    print_choices >&2
    exit 2
fi

COMMON_PACKAGES="dbus dbus-x11 font-dejavu mesa-dri-gallium mesa-egl mesa-gl"

case "$desktop" in
    xfce)
        label="XFCE"
        packages="xfce4 xfce4-terminal"
        ;;
    lxqt)
        label="LXQt"
        packages="lxqt-desktop qterminal qt6-qtbase-x11"
        ;;
    lxde)
        label="LXDE"
        packages="lxsession openbox pcmanfm lxpanel lxterminal lxappearance"
        ;;
    openbox)
        label="Openbox"
        packages="openbox pcmanfm lxterminal tint2"
        ;;
    mate)
        label="MATE"
        packages="mate-desktop-environment mate-terminal"
        ;;
    plasma)
        label="Plasma"
        packages="plasma-desktop plasma-workspace kwin konsole breeze breeze-icons qt6-qtbase-x11"
        ;;
esac

echo
echo "Selected: $label"
if [ "$desktop" = "plasma" ]; then
    echo "NOTE: Plasma is the largest choice. Alpine 3.24 may not ship the old"
    echo "      startplasma-x11 launcher; start-desktop has an experimental"
    echo "      kwin_x11 + plasmashell fallback for the integrated X11 display."
fi
echo
echo "Refreshing Alpine package indexes..."
if ! "$APK_CMD" update; then
    echo "ERROR: apk update failed. Check network/DNS and retry." >&2
    exit 1
fi

echo
echo "Installing $label..."
# shellcheck disable=SC2086
if ! "$APK_CMD" add $COMMON_PACKAGES $packages; then
    echo "ERROR: $label installation failed. No desktop selection was changed." >&2
    exit 1
fi

# Alpine versions that still publish plasma-workspace-x11 provide the normal
# startplasma-x11 session launcher there. It disappeared from newer branches,
# so treat it as optional instead of making Plasma installation fail.
if [ "$desktop" = "plasma" ] && [ ! -x /usr/bin/startplasma-x11 ]; then
    if "$APK_CMD" search -x plasma-workspace-x11 2>/dev/null | grep -q '^plasma-workspace-x11'; then
        echo "Installing optional Plasma X11 session package..."
        "$APK_CMD" add plasma-workspace-x11 || echo "WARNING: optional plasma-workspace-x11 install failed."
    fi
fi

printf '%s\n' "$desktop" > "$CONFIG_FILE" || {
    echo "ERROR: could not save desktop selection to $CONFIG_FILE" >&2
    exit 1
}
chmod 0644 "$CONFIG_FILE" 2>/dev/null || true

echo
echo "$label installation finished."
echo "Default desktop: $desktop"
echo "Start it with:"
echo
echo "  start-desktop"
echo
echo "To install/switch to another desktop later, run install-desktop again."
