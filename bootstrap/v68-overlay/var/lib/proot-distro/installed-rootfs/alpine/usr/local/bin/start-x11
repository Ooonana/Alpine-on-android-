#!/bin/sh

android_sdk="$(/system/bin/getprop ro.build.version.sdk 2>/dev/null || true)"
case "$android_sdk" in
    ""|*[!0-9]*)
        echo "ERROR: unable to determine Android SDK level; Alpine Display requires Android 8.0 (API 26) or newer." >&2
        exit 3
        ;;
    *)
        if [ "$android_sdk" -lt 26 ]; then
            echo "ERROR: Alpine Display requires Android 8.0 (API 26) or newer; detected API $android_sdk." >&2
            exit 3
        fi
        ;;
esac

display=":1"
open_activity=1
for arg in "$@"; do
    case "$arg" in
        --no-open)
            open_activity=0
            ;;
        *)
            display="$arg"
            ;;
    esac
done

case "$display" in
    :*) ;;
    *) display=":$display" ;;
esac

display_number="${display#:}"
display_number="${display_number%%.*}"
case "$display_number" in
    ""|*[!0-9]*)
        echo "ERROR: invalid X11 display: $display" >&2
        exit 2
        ;;
esac
socket_dir="${TMPDIR:-/tmp}/.X11-unix"
socket_path="$socket_dir/X$display_number"
log_file="/tmp/termux-x11.log"
request_file="/tmp/alpine-x11-request"
request_tmp="/tmp/alpine-x11-request.$$"
activity_request_file="/tmp/alpine-x11-open-activity"
activity_request_tmp="/tmp/alpine-x11-open-activity.$$"
server_pid_file="/tmp/alpine-x11-server.pid"

export DISPLAY="$display"
export TMPDIR="${TMPDIR:-/tmp}"
uid="$(id -u 2>/dev/null || echo 0)"
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ "$XDG_RUNTIME_DIR" = "$TMPDIR" ]; then
    XDG_RUNTIME_DIR="$TMPDIR/alpine-runtime-$uid"
fi
export XDG_RUNTIME_DIR
mkdir -p "$XDG_RUNTIME_DIR" || exit 1
chmod 0700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

proc_start_time() {
    pid="$1"
    case "$pid" in
        ""|*[!0-9]*) return 1 ;;
    esac
    [ -r "/proc/$pid/stat" ] || return 1
    stat_line="$(cat "/proc/$pid/stat" 2>/dev/null)" || return 1
    stat_fields="${stat_line#*) }"
    [ "$stat_fields" != "$stat_line" ] || return 1
    stat_start="$(printf '%s\n' "$stat_fields" | awk 'NF >= 20 { print $20; found=1 } END { if (!found) exit 1 }')" || return 1
    [ -n "$stat_start" ] || return 1
    printf '%s\n' "$stat_start"
}

pid_identity_file_alive() {
    identity_file="$1"
    [ -r "$identity_file" ] || return 1
    read -r identity_pid identity_start < "$identity_file" || return 1
    [ -n "$identity_start" ] || return 1
    kill -0 "$identity_pid" 2>/dev/null || return 1
    current_start="$(proc_start_time "$identity_pid")" || return 1
    [ "$current_start" = "$identity_start" ]
}

if [ -d /usr/share/X11/xkb ]; then
    export XKB_CONFIG_ROOT="${XKB_CONFIG_ROOT:-/usr/share/X11/xkb}"
fi

ensure_x11_font_indexes() {
    command -v mkfontscale >/dev/null 2>&1 || return 0

    for font_dir in \
        /usr/share/fonts/misc \
        /usr/share/fonts/100dpi \
        /usr/share/fonts/75dpi \
        /usr/share/fonts/Type1; do
        [ -d "$font_dir" ] || continue
        [ ! -f "$font_dir/fonts.dir" ] || continue

        mkfontscale "$font_dir" >/dev/null 2>&1 || true
        if command -v mkfontdir >/dev/null 2>&1; then
            mkfontdir "$font_dir" >/dev/null 2>&1 || true
        fi
    done
}

ensure_x11_font_indexes

if [ -S "$socket_path" ] && ! pid_identity_file_alive "$server_pid_file"; then
    echo "Removing stale Alpine display socket at $socket_path"
    rm -f "$socket_path" "$server_pid_file"
fi

if [ -S "$socket_path" ]; then
    echo "Alpine display socket already exists at $socket_path"
else
    mkdir -p "$socket_dir"
    : > "$log_file"
    echo "Requesting Alpine display on DISPLAY=$DISPLAY"
    echo "$DISPLAY" > "$request_tmp" 2>>"$log_file"
    mv "$request_tmp" "$request_file" 2>>"$log_file"
    if [ "$open_activity" = "1" ]; then
        echo "$DISPLAY" > "$activity_request_tmp" 2>>"$log_file"
        mv "$activity_request_tmp" "$activity_request_file" 2>>"$log_file"
    fi

    i=0
    while [ "$i" -lt 45 ]; do
        [ -S "$socket_path" ] && break
        sleep 1
        i=$((i + 1))
    done
fi

echo "DISPLAY=$DISPLAY"
echo "X11 log: $log_file"
if [ -S "$socket_path" ]; then
    echo "X11 socket: $socket_path"
    echo "Run GUI apps with DISPLAY=$DISPLAY, for example: DISPLAY=$DISPLAY xterm"
else
    echo "WARNING: X11 socket was not created at $socket_path"
    echo "--- Last X11 log lines ---"
    tail -n 80 "$log_file" 2>/dev/null || true
fi
