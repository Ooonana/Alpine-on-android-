#!/bin/sh

set -u

shadow_file="/etc/shadow"

password_is_set() {
    [ -r "$shadow_file" ] || return 1
    password_field="$(awk -F: '$1 == "root" { print $2; exit }' "$shadow_file" 2>/dev/null || true)"
    case "$password_field" in
        ''|'!'*|'*') return 1 ;;
        *) return 0 ;;
    esac
}

case "${1:-}" in
    --check)
        password_is_set
        exit $?
        ;;
    --status)
        if password_is_set; then
            echo "Root desktop password: set"
            exit 0
        fi
        echo "Root desktop password: not set (account is locked for password authentication)"
        exit 1
        ;;
    --help|-h)
        cat <<'EOF'
Usage:
  set-desktop-password
  set-desktop-password --status

Sets the root password used by mobile desktop lock screens. Alpine-on-Android
ships with root password authentication locked; there is no default password.
EOF
        exit 0
        ;;
    '') ;;
    *)
        echo "ERROR: unknown option: $1" >&2
        exit 2
        ;;
esac

if [ "$(id -u 2>/dev/null || echo 1)" != "0" ]; then
    echo "ERROR: set-desktop-password must run as root inside Alpine." >&2
    exit 1
fi
if ! command -v passwd >/dev/null 2>&1; then
    echo "ERROR: passwd command is unavailable." >&2
    exit 1
fi

cat <<'EOF'
Alpine-on-Android does not use a default desktop password.
Choose a password below. It will be stored by Alpine's normal password system
and is not written into the APK or project source.
EOF
exec passwd root
