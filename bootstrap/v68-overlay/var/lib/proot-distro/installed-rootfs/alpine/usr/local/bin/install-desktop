#!/bin/sh

set -u

if ! command -v desktop-manager >/dev/null 2>&1; then
    echo "ERROR: desktop-manager is missing from this Alpine installation." >&2
    exit 1
fi

case "${1:-}" in
    --help|-h)
        cat <<'EOF'
Usage:
  install-desktop
  install-desktop <desktop> [desktop ...]
  install-desktop --list

Compatibility wrapper for `desktop-manager install`.
Multiple desktops can be installed at once. The last successfully installed
selection becomes the default used by start-desktop.
EOF
        exit 0
        ;;
    --list)
        exec desktop-manager available
        ;;
esac

exec desktop-manager install "$@"
