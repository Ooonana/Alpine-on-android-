#!/bin/sh

set -u

if ! command -v phosh-session >/dev/null 2>&1; then
    echo "ERROR: phosh-session is not installed." >&2
    exit 1
fi

ALPINE_BACKGROUND_URI="file:///usr/share/backgrounds/alpine-on-android.svg"

repair_missing_default_background() {
    schema="$1"
    key="$2"
    command -v gsettings >/dev/null 2>&1 || return 0
    current="$(gsettings get "$schema" "$key" 2>/dev/null || true)"
    case "$current" in
        "'file:///usr/share/backgrounds/gnome/"*"'")
            uri="${current#\'}"
            uri="${uri%\'}"
            path="${uri#file://}"
            if [ ! -r "$path" ]; then
                gsettings set "$schema" "$key" "$ALPINE_BACKGROUND_URI" >/dev/null 2>&1 || true
            fi
            ;;
    esac
}

prepare_phosh_preferences() {
    repair_missing_default_background org.gnome.desktop.background picture-uri
    repair_missing_default_background org.gnome.desktop.background picture-uri-dark
    repair_missing_default_background org.gnome.desktop.screensaver picture-uri
    if command -v gsettings >/dev/null 2>&1; then
        # Keep the GNOME touch-keyboard preference enabled. phosh-session owns
        # sm.puri.OSK0 and must be the only Squeekboard launcher; V69.7's second
        # manual launcher raced that required component and caused respawn loops.
        gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true >/dev/null 2>&1 || true
    fi
}

prepare_phosh_preferences
phosh-session &
session_pid=$!
resize_pid=""

if command -v phosh-resize-sync >/dev/null 2>&1; then
    phosh-resize-sync "$session_pid" >>/tmp/alpine-phosh-resize.log 2>&1 &
    resize_pid=$!
fi

forward_signal() {
    kill -TERM "$session_pid" 2>/dev/null || true
}
trap forward_signal HUP INT TERM

wait "$session_pid"
status=$?

if [ -n "$resize_pid" ]; then
    kill "$resize_pid" 2>/dev/null || true
    wait "$resize_pid" 2>/dev/null || true
fi
trap - HUP INT TERM
exit "$status"
